# Copy to .env.local and fill in the keys. .env.local is git-ignored.

# App (Vite): where the backend runs. `npm run worker:dev` serves it on port 8787.
VITE_API_URL=http://localhost:8787

# Backend (Cloudflare Worker): at least one key. Anthropic is asked first, OpenAI when Anthropic does not answer.
# In production these are Worker secrets: npx wrangler secret put ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
